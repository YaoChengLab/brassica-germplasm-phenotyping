# BPP Environment Variables Template
# Copy this file to .env and fill in the actual values for your environment
#
# DO NOT commit the actual .env file to git (it contains secrets!)
# Only commit this .env.template file

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL database credentials
# Used by: database service, api-service
# The password is fixed when the database volume is first created; changing it
# later needs a new volume (docker compose down -v, which deletes the data).
DB_USER=phenouser
DB_PASSWORD=change-me

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment type: development | staging | production
ENVIRONMENT=development

# Enable debug mode (shows detailed error messages)
# Set to 'false' in production
DEBUG=true

# Base URL of the frontend application
# Used by backend for CORS and links
BASE_URL=http://localhost:3000

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# API URL for the React frontend
#
# In Docker environment:
#   Use relative URL '/api/v1' - nginx proxy forwards to backend
#   VITE_APP_API_URL=/api/v1
#
# In local development (npm run dev):
#   Use full URL 'http://localhost:8000/api/v1'
#   VITE_APP_API_URL=http://localhost:8000/api/v1
#
# The frontend's api.jsx uses: import.meta.env.VITE_APP_API_URL || '/api/v1'
# So this variable configures the API endpoint dynamically
VITE_APP_API_URL=/api/v1

# ============================================================================
# OPERATOR
# ============================================================================

# The platform has no login: every request runs as this operator, whose name is
# recorded in batch milestones, export provenance and logs. Anyone who can reach
# the API can write to the database, so keep the services on localhost or a
# trusted network.
BPP_OPERATOR=admin
